# Web client build-time settings (Vite). Copy to apps/web/.env.local or export them before `pnpm dev` / `vite build`.
# Values are baked into the bundle and public; never put secrets here.

# Optional Colyseus endpoint override (default: the page origin; `/colyseus` through the Vite proxy in dev).
# VITE_COLYSEUS_URL=wss://game.example.com

# Home-screen social badges. Each icon renders only when its URL is set (absolute http/https URLs only).
# VITE_SOCIAL_X_URL=https://x.com/your-handle
# VITE_SOCIAL_DISCORD_URL=https://discord.gg/your-invite
# VITE_SOCIAL_PATREON_URL=https://www.patreon.com/your-page
